#pragma once

#include <musa_runtime.h>

#include <cstdint>
#include <vector>

namespace hadamard_musa {

// 输入和输出均使用 16 bit 位模式保存；BF16 使用高 16 位格式。
enum class DType : int {
    FP16 = 0,
    BF16 = 1,
};

struct KernelTiming {
    float milliseconds = 0.0f;
};

const char* dtype_name(DType dtype);
std::size_t tensor_bytes(int rows, int dim);
std::size_t int4_packed_bytes(int rows, int dim);

void check_musa_status(
    musaError_t status,
    const char* expression,
    const char* file,
    int line);

#define HADAMARD_MUSA_CHECK(expression) \
    ::hadamard_musa::check_musa_status((expression), #expression, __FILE__, __LINE__)

KernelTiming launch_hadamard_shared(
    const void* input,
    void* output,
    int rows,
    int dim,
    DType dtype,
    int repeats = 1);

KernelTiming launch_quantize_int4(
    const void* transformed,
    std::uint8_t* packed,
    float* scales,
    int rows,
    int dim,
    DType dtype,
    int repeats = 1);

KernelTiming launch_fused_hadamard_int4(
    const void* input,
    std::uint8_t* packed,
    float* scales,
    int rows,
    int dim,
    DType dtype,
    int repeats = 1);

KernelTiming launch_quantize_e4m3(
    const void* transformed,
    std::uint8_t* encoded,
    int rows,
    int dim,
    DType dtype,
    int repeats = 1);

KernelTiming launch_fused_hadamard_e4m3(
    const void* input,
    std::uint8_t* encoded,
    int rows,
    int dim,
    DType dtype,
    int repeats = 1);

std::uint16_t float_to_fp16_bits(float value);
float fp16_bits_to_float(std::uint16_t bits);
std::uint16_t float_to_bf16_bits(float value);
float bf16_bits_to_float(std::uint16_t bits);

}  // namespace hadamard_musa
